# Copy to .env and fill in what you have. Everything is optional —
# the engine works with zero API keys (MX-level email checks, direct
# website discovery). Keys unlock higher-quality enrichment.

# Server
PORT=3000

# --- Deployment (required when hosted on a public URL) ---
# When DASHBOARD_PASSWORD is set, the whole app requires a sign-in.
DASHBOARD_USER=innovat3
DASHBOARD_PASSWORD=

# Auto-run the pipeline daily at this hour (0-23, Eastern time). Leave
# empty to only run manually / via external cron.
DAILY_RUN_HOUR=7
DAILY_RUN_LIMIT=100

# Where the SQLite DB + downloaded extracts live (default: ./data)
DATA_DIR=

# --- Contact enrichment (optional, recommended) ---
# apollo.io — B2B contact database. Given the decision-maker name + business
# we pull from state records, returns their verified work email, phone and
# LinkedIn. Get a key: apollo.io → Settings → Integrations → API.
# Note: the API is available on paid plans; each match uses an export credit.
APOLLO_API_KEY=

# --- Census market intelligence (optional, free) ---
# Powers /api/markets/<vertical> — "where should we prospect HVAC?"
# Free instant key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- SAM.gov federal contractors (optional, free) ---
# Free key: sam.gov → Account Details → API Key (or api.data.gov)
SAM_API_KEY=

# --- Email verification providers (optional, pick one) ---
# hunter.io — email finder + verifier (~$49/mo)
HUNTER_API_KEY=
# zerobounce.net — email verifier (pay as you go)
ZEROBOUNCE_API_KEY=

# --- Web search provider for website/social discovery (optional) ---
# serper.dev — Google search API ($50 for 50k searches). Dramatically
# improves website + Facebook/Instagram discovery for businesses
# without guessable domain names.
SERPER_API_KEY=

# --- Sunbiz SFTP (public credentials, published by FL Dept. of State) ---
# https://dos.fl.gov/sunbiz/other-services/data-downloads/
SUNBIZ_SFTP_HOST=sftp.floridados.gov
SUNBIZ_SFTP_USER=Public
SUNBIZ_SFTP_PASSWORD=PubAccess1845!
