# Copy to .env and fill in what you have. Everything is optional —
# the engine works with zero API keys (MX-level email checks, direct
# website discovery). Keys unlock higher-quality enrichment.

# Server
PORT=3000

# --- Email verification providers (optional, pick one) ---
# hunter.io — email finder + verifier (~$49/mo)
HUNTER_API_KEY=
# zerobounce.net — email verifier (pay as you go)
ZEROBOUNCE_API_KEY=

# --- Web search provider for website/social discovery (optional) ---
# serper.dev — Google search API ($50 for 50k searches). Dramatically
# improves website + Facebook/Instagram discovery for businesses
# without guessable domain names.
SERPER_API_KEY=

# --- Sunbiz SFTP (public credentials, published by FL Dept. of State) ---
# https://dos.fl.gov/sunbiz/other-services/data-downloads/
SUNBIZ_SFTP_HOST=sftp.floridados.gov
SUNBIZ_SFTP_USER=Public
SUNBIZ_SFTP_PASSWORD=PubAccess1845!
