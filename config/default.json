{
  "pipeline": {
    "defaultLimit": 100,
    "defaultDaysWindow": 180,
    "requireContact": true,
    "enrichConcurrency": 5,
    "requestTimeoutMs": 10000,
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
  },
  "scoring": {
    "mode": "digital_services",
    "weights": {
      "hasContactName": 15,
      "hasPhone": 15,
      "emailVerified": 20,
      "emailValidMx": 14,
      "emailGuessed": 6,
      "recencyMax": 20,
      "activeStatus": 5,
      "digital_services": {
        "noWebsite": 15,
        "socialOnly": 10,
        "hasWebsite": 4
      },
      "reachability": {
        "noWebsite": 0,
        "socialOnly": 6,
        "hasWebsite": 12
      }
    }
  },
  "sunbiz": {
    "enabled": true,
    "sftp": {
      "host": "sftp.floridados.gov",
      "user": "Public",
      "password": "PubAccess1845!",
      "dir": "/Public/doc/cor"
    },
    "filingTypesInclude": [
      "FLAL",
      "DOML",
      "DOMP",
      "FLP",
      "NONP"
    ],
    "excludeNameKeywords": [
      "HOLDINGS",
      "TRUST",
      "HOA",
      "HOMEOWNERS",
      "CONDOMINIUM ASSOCIATION"
    ]
  },
  "dbpr": {
    "enabled": true,
    "baseUrl": "https://www2.myfloridalicense.com/sto/file_download/extracts/",
    "boards": [
      {
        "key": "construction",
        "label": "Construction Contractors",
        "file": "CONSTRUCTIONLICENSE_1.csv",
        "enabled": true
      },
      {
        "key": "electrical",
        "label": "Electrical Contractors",
        "file": "lic08el.csv",
        "enabled": true
      },
      {
        "key": "cosmetology",
        "label": "Cosmetology / Salons",
        "file": "COSMETOLOGYLICENSE_1.csv",
        "enabled": true
      },
      {
        "key": "barbers",
        "label": "Barbers / Barbershops",
        "file": "lic03bb.csv",
        "enabled": true
      },
      {
        "key": "restaurants",
        "label": "Restaurants (new approvals)",
        "file": "newfood.csv",
        "type": "newfood",
        "enabled": true
      },
      {
        "key": "real_estate",
        "label": "Real Estate Agents & Brokers",
        "file": "REALESTATE2501LICENSE_1.csv",
        "enabled": true
      },
      {
        "key": "real_estate_corps",
        "label": "Real Estate Companies",
        "file": "RealEstateCorpLicense.csv",
        "enabled": true
      },
      {
        "key": "veterinary",
        "label": "Veterinarians",
        "file": "lic26vt.csv",
        "enabled": true
      },
      {
        "key": "home_inspectors",
        "label": "Home Inspectors",
        "file": "lic04home.csv",
        "enabled": true
      }
    ]
  },
  "nppes": {
    "enabled": true,
    "filesPage": "https://download.cms.gov/nppes/NPI_Files.html",
    "state": "FL"
  },
  "sam": {
    "enabled": true,
    "state": "FL"
  },
  "osm": {
    "enabled": true,
    "overpassUrl": "https://overpass-api.de/api/interpreter",
    "categories": {
      "restaurants": {
        "label": "Restaurants & Cafes",
        "filters": [
          "amenity~\"^(restaurant|cafe|fast_food|bar)$\""
        ]
      },
      "beauty": {
        "label": "Beauty / Salons / Barbers",
        "filters": [
          "shop~\"^(beauty|hairdresser|massage|tattoo)$\""
        ]
      },
      "trades": {
        "label": "Trades & Crafts",
        "filters": [
          "craft"
        ]
      },
      "retail": {
        "label": "Retail Shops",
        "filters": [
          "shop"
        ]
      },
      "offices": {
        "label": "Offices & Services",
        "filters": [
          "office"
        ]
      },
      "fitness": {
        "label": "Gyms & Fitness",
        "filters": [
          "leisure~\"^(fitness_centre|sports_centre)$\""
        ]
      },
      "auto": {
        "label": "Auto Repair & Dealers",
        "filters": [
          "shop~\"^(car_repair|car|tyres)$\""
        ]
      },
      "medical": {
        "label": "Clinics & Medical",
        "filters": [
          "amenity~\"^(clinic|dentist|doctors|pharmacy|veterinary)$\""
        ]
      }
    }
  },
  "enrichment": {
    "website": {
      "tlds": [
        "com",
        "net",
        "biz"
      ],
      "maxCandidates": 12,
      "minMatchScore": 3
    },
    "email": {
      "allowGuessed": false,
      "patterns": [
        "info",
        "contact",
        "office",
        "hello",
        "{first}",
        "{first}.{last}",
        "{f}{last}"
      ],
      "smtpProbe": false
    },
    "ai": {
      "enabled": true,
      "maxPages": 3
    }
  }
}